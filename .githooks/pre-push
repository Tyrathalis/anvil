#!/usr/bin/env bash
# Local push gate (mirrors the blocking CI: ruff + pytest; pyright stays
# CI-only/non-blocking until the D3-era typing sweep). Enable once per clone:
#   git config core.hooksPath .githooks
# Escape hatch: SKIP_HOOK=1 git push
set -euo pipefail
if [[ "${SKIP_HOOK:-0}" == "1" ]]; then
  echo "[pre-push] SKIP_HOOK=1 — skipping local checks"
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
# A calibrated timing (anvil.runs launch --quiet-box) is running: the test suite would load the box.
if ! uv run python -m anvil.runs quiet; then
  echo "[pre-push] held: wait for the run, or SKIP_HOOK=1 git push to push without the checks"
  exit 1
fi
echo "[pre-push] ruff check..."
uv run ruff check anvil scripts tests
echo "[pre-push] pytest (CPU, as CI runs it — a GPU cotenant must never park the gate)..."
CUDA_VISIBLE_DEVICES="" uv run pytest -q
echo "[pre-push] green — pushing"
